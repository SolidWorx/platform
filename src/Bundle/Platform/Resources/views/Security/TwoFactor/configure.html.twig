{# The page behind the "Two-factor authentication" entry in the user menu. It extends the UI
   bundle's application layout, so it inherits whatever `platform.ui.templates` an application
   configures; override this template outright for full control. #}
{% extends ui_layout_app %}

{% block page_pretitle %}{{ 'Security'|trans }}{% endblock %}

{% block page_title %}{{ 'Two-factor authentication'|trans }}{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <twig:Platform:Security:TwoFactor />
        </div>
    </div>
{% endblock %}
