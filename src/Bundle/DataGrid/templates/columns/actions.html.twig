{%- set id = row[idField]|default(null) -%}
<div class="btn-list flex-nowrap justify-content-end">
{%- for action in actions -%}
    {%- if action.type == 'CUSTOM' -%}
        {%- if id is not null -%}
        <a class="btn btn-sm btn-ghost-secondary"
           href="{{ path(action.route, {(action.routeParameter): id}) }}"
           data-action-type="CUSTOM"
           title="{{ action.label }}">
            {{ ux_icon(action.icon, {class: 'icon icon-sm', 'aria-hidden': 'true'}) }}
            <span class="visually-hidden">{{ action.label }}</span>
        </a>
        {%- endif -%}
    {%- else -%}
        <button type="button"
                class="btn btn-sm btn-ghost-{{ action.type == 'DELETE' ? 'danger' : 'secondary' }}"
                data-action-type="{{ action.type }}"
                data-id="{{ id }}"
                {%- if action.confirm is not null %} data-confirm="{{ action.confirm }}"{% endif %}
                title="{{ action.label }}">
            {{ ux_icon(action.icon, {class: 'icon icon-sm', 'aria-hidden': 'true'}) }}
            <span class="visually-hidden">{{ action.label }}</span>
        </button>
    {%- endif -%}
{%- endfor -%}
</div>
