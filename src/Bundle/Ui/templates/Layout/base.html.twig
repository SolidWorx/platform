{##
    The base layout — it owns the HTML document (head, meta, assets, body) and nothing else.

    Every layout shipped by the platform (`app`, `condensed`, `clean`) extends it, and applications
    can replace it wholesale through `platform.ui.templates.base`.

    Layout options are resolved here, once, so every layout shares the same contract. They are
    merged in order of increasing precedence:

        1. the defaults on SolidWorx\Platform\UiBundle\Layout\LayoutOption
        2. `platform.ui.layout.*` from the application's platform.yaml
        3. the `layout` variable the template sets when it extends a layout

    The recommended way to set them is `ui_layout()`, because it has a real PHP signature — your
    IDE can complete the argument names and an option that does not exist is an error rather than a
    silent no-op:

        {% extends ui_layout_app %}
        {% set layout = ui_layout(navbar_theme: 'dark', navbar_sticky: true, fluid: true) %}

    A plain hash works too, and is validated just the same:

        {% set layout = {navbar_theme: 'dark', navbar_sticky: true, fluid: true} %}
##}


{%- use '@Ui/Layout/partials/_brand.html.twig' -%}
{%- use '@Ui/Layout/partials/_user_menu.html.twig' -%}
{%- use '@Ui/Layout/partials/_flashes.html.twig' -%}
{%- use '@Ui/Layout/partials/_page_header.html.twig' -%}
{%- use '@Ui/Layout/partials/_footer.html.twig' -%}

{% types {
    ## Layout options, best built with `ui_layout()`. See LayoutOption for the full list.
    layout?: 'map',
    ## Extra classes to put on the `<body>` element.
    body_class?: 'string',
    ## Where the brand in the navbar and sidebar links to. Defaults to `/`.
    brand_url?: 'string',
} %}

{##
    Resolved options, available to every block and partial as `layout.<option>`.
    Keys are guaranteed present, so `layout.navbar_sticky` never needs a `|default`.
##}
{%- set layout = ui_layout_resolve(layout|default({})) -%}


{%- set container_class = layout.container ?? (layout.fluid ? 'container-fluid' : 'container-xl') -%}
{%- set body_class = (html_classes({
    'layout-fluid': layout.fluid,
    'layout-boxed': layout.boxed,
}) ~ ' ' ~ body_class|default(''))|trim -%}
{%- set locale = app.request.locale|split('_')[0] -%}

<!doctype html>

<html lang="{{ locale }}"{% if layout.theme is not null %} data-bs-theme="{{ layout.theme }}"{% endif %}{% block html_attributes %}{% endblock %}>

<head>
    {% block head %}
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />

        <title>{% block head_title %}{% set head_title = block('page_title')|striptags|trim %}{{ (head_title is not empty ? head_title ~ ' · ' : '')|raw }}{{ ui_app_name|default('') }}{% endblock %}</title>

        {% block head_meta %}
            {# TODO: Allow to define a custom theme color #}
            <meta name="msapplication-TileColor" content="#066fd1" />
            <meta name="theme-color" content="#066fd1" />
            <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
            <meta name="apple-mobile-web-app-capable" content="yes" />
            <meta name="mobile-web-app-capable" content="yes" />
            <meta name="HandheldFriendly" content="True" />
            <meta name="MobileOptimized" content="320" />

            {% if app.current_route is not empty -%}
                <meta name="canonical" content="{{ url(app.current_route, app.current_route_parameters, false) }}" />
            {%- endif %}

            {# TODO: Add description and keywords meta #}
            {# <meta name="description" content=""> #}
        {% endblock head_meta %}

        {% block favicon %}
            <link rel="icon" href="{{ asset('/favicon.ico') }}" type="image/x-icon" />
            <link rel="shortcut icon" href="{{ asset('/favicon.ico') }}" type="image/x-icon" />
        {% endblock favicon %}

        {% block stylesheets %}
            {{ encore_entry_link_tags('_platform_ui') }}
        {% endblock stylesheets %}
    {% endblock head %}
</head>

<body{% if body_class is not empty %} class="{{ body_class }}"{% endif %}{% block body_attributes %}{% endblock %}>
{% block body %}{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('_platform_ui') }}
{% endblock javascripts %}
</body>

</html>
