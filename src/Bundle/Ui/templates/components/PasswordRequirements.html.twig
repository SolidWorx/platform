{#
    The rules a new password has to satisfy, as a checklist. Pass the sentences from
    `PasswordPolicyInterface::requirements()`, so the list shown is the list validated:

        <twig:Ui:PasswordRequirements :requirements="password_requirements" />

    Used wherever a password is chosen — the change-password and reset-password pages — so the
    rules read the same in both. Renders nothing for an empty list.
#}

{% props requirements = [] %}

{% if requirements is not empty %}
    <twig:Ui:Alert type="info" icon="tabler:info-circle" title="{{ 'Password requirements'|trans }}" class="{{ attributes.render('class')|default('') }}">
        <ul class="list-unstyled mb-0">
            {% for requirement in requirements %}
                <li class="d-flex align-items-center mt-1">
                    {{ ux_icon('tabler:check', {class: 'icon icon-sm me-2 flex-shrink-0'}) }}
                    {{ requirement|trans }}
                </li>
            {% endfor %}
        </ul>
    </twig:Ui:Alert>
{% endif %}
