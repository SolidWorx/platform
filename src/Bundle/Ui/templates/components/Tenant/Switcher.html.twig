{##
    The workspace switcher: a navbar dropdown naming the workspace you are in.

    Renders nothing unless there is a workspace to name — the user belongs to none, or the tenant is
    pinned to the request by a custom domain. Callers therefore never need to wrap it:

        <twig:Platform:Tenant:Switcher />

    The entries are the workspaces the user can move to, followed by a link to create another one
    when `TENANT_CREATE` is granted — the same permission the onboarding page itself checks.
##}
{% if isAvailable %}
    <div class="nav-item dropdown">
        <a
            href="#"
            class="nav-link d-flex lh-1 align-items-center px-2"
            data-bs-toggle="dropdown"
            aria-label="{{ 'Open workspace menu'|trans }}"
        >
            {{ ux_icon('tabler:building', {class: 'icon'}) }}

            <span class="d-none d-lg-block ps-2">
                {{ current ? current.name : 'Select a workspace'|trans }}
            </span>

            {{ ux_icon('tabler:chevron-down', {class: 'icon icon-sm ms-1 d-none d-lg-block'}) }}
        </a>

        <div class="dropdown-menu dropdown-menu-arrow">
            <div class="dropdown-header">{{ 'Workspaces'|trans }}</div>

            {% for tenant in tenants %}
                <form method="post" action="{{ path('solidworx_platform_tenant_select') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('tenant_select') }}" />
                    <input type="hidden" name="tenant" value="{{ tenant.id }}" />
                    <button type="submit" class="dropdown-item d-flex align-items-center w-100 text-start">
                        <span class="flex-fill">{{ tenant.name }}</span>
                        {# `current` is the very entry from `tenants` that is in scope, so identity is exact. #}
                        {% if current is same as(tenant) %}
                            {{ ux_icon('tabler:check', {class: 'text-success ms-2'}) }}
                        {% endif %}
                    </button>
                </form>
            {% endfor %}

            {% if is_granted('TENANT_CREATE') %}
                <div class="dropdown-divider"></div>

                <a href="{{ path('solidworx_platform_tenant_onboarding') }}" class="dropdown-item d-flex align-items-center">
                    {{ ux_icon('tabler:plus', {class: 'icon me-2'}) }}
                    {{ 'Create new workspace'|trans }}
                </a>
            {% endif %}
        </div>
    </div>
{% endif %}
