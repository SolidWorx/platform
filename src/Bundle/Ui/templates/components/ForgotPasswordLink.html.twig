{#
    The "Forgot password?" link that sits in a password field's label, on the login page and the
    change-password page. Renders nothing while `platform.security.reset_password` is disabled, so
    callers do not have to check.

        <label class="form-label">
            {{ 'Password'|trans }}
            <twig:Ui:ForgotPasswordLink />
        </label>
#}

{% if platform_reset_password_enabled|default(false) %}
    <span {{ attributes.without('class') }} class="{{ html_classes('form-label-description', attributes.render('class')|default('')) }}">
        <a href="{{ path('_solidworx_platform_reset_password_request') }}">{{ 'Forgot password?'|trans }}</a>
    </span>
{% endif %}
