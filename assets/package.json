{
  "name": "@solidworx/platform",
  "description": "SolidWorx Platform UI scripts",
  "license": "MIT",
  "version": "1.0.0",
  "main": "./core.ts",
  "module": "./core.ts",
  "types": "./core.d.ts",
  "type": "module",
  "files": [
    "controllers",
    "core.ts",
    "core.d.ts",
    "scss",
    "webpack.config.js"
  ],
  "keywords": [
    "symfony-ux"
  ],
  "scripts": {
    "build": "encore production --config webpack.config.standalone.js",
    "dev": "encore dev --config webpack.config.standalone.js",
    "watch": "encore dev --watch --config webpack.config.standalone.js"
  },
  "symfony": {
    "controllers": {
      "modal": {
        "main": "controllers/modal.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "modal-prefill": {
        "main": "controllers/modal_prefill.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "csrf-protection": {
        "main": "controllers/csrf_protection.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "loading": {
        "main": "controllers/loading.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "text-editor": {
        "main": "controllers/text_editor_controller.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.2.2",
      "@tabler/core": "^1.5.1"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@tabler/core": "^1.5.1"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@stimulus-components/checkbox-select-all": "^6.1.0",
    "@stimulus-components/clipboard": "^5.0.0",
    "@stimulus-components/password-visibility": "^3.0.0",
    "@symfony/ux-turbo": "^2.31.0",
    "@symfony/ux-live-component": "^2.31.0",
    "@symfony/ux-chartjs": "^2.31.0",
    "@symfony/ux-autocomplete": "^2.31.0",
    "@tabler/core": "^1.5.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/starter-kit": "^2.11.5",
    "postcss": "^8.4.0",
    "postcss-loader": "^8.1.0",
    "postcss-prefix-custom-properties": "^0.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.0",
    "@babel/preset-env": "^7.16.0",
    "@symfony/webpack-encore": "^5.2.0",
    "eslint-webpack-plugin": "^5.0.2",
    "core-js": "^3.46.0",
    "jquery": "^3.7.1",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.93.0",
    "sass-loader": "^16.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.3.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-notifier": "^1.15.0"
  },
  "peerDependenciesMeta": {
    "@tabler/core": {
      "optional": false
    },
    "@hotwired/stimulus": {
      "optional": false
    },
    "webpack": {
      "optional": false
    }
  }
}
