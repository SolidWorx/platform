{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SolidWorx Platform Configuration",
    "description": "Configuration schema for platform.yaml",
    "type": "object",
    "properties": {
        "platform": {
            "type": "object",
            "description": "Platform configuration",
            "properties": {
                "name": {
                    "description": "The name of the platform.",
                    "default": "SolidWorx Platform",
                    "type": "string"
                },
                "version": {
                    "description": "The version of the platform.",
                    "default": "1.0.0",
                    "type": "string"
                },
                "security": {
                    "default": {
                        "two_factor": {
                            "enabled": false,
                            "base_template": null
                        }
                    },
                    "type": "object",
                    "properties": {
                        "two_factor": {
                            "default": {
                                "enabled": false,
                                "base_template": null
                            },
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "description": "Enable two-factor authentication.",
                                    "default": false,
                                    "type": "boolean"
                                },
                                "base_template": {
                                    "description": "The base layout template for 2FA pages.",
                                    "default": null,
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                "doctrine": {
                    "default": {
                        "types": {
                            "enable_utc_date": true
                        }
                    },
                    "type": "object",
                    "properties": {
                        "types": {
                            "default": {
                                "enable_utc_date": true
                            },
                            "type": "object",
                            "properties": {
                                "enable_utc_date": {
                                    "description": "Enable UTC date type.",
                                    "default": true,
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                "models": {
                    "default": {
                        "user": "SolidWorx\\Platform\\PlatformBundle\\Entity\\User"
                    },
                    "type": "object",
                    "properties": {
                        "user": {
                            "description": "The User model class.",
                            "default": "SolidWorx\\Platform\\PlatformBundle\\Entity\\User",
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                },
                "multi_tenancy": {
                    "default": {
                        "enabled": false,
                        "session_key": "_tenant_id",
                        "route_param": "tenant",
                        "validate_user_access": true,
                        "models": {
                            "tenant": "SolidWorx\\Platform\\PlatformBundle\\Entity\\Tenant",
                            "user_tenant": "SolidWorx\\Platform\\PlatformBundle\\Entity\\UserTenant"
                        },
                        "resolvers": {
                            "domain": true,
                            "session": true,
                            "route": false
                        },
                        "write_guard": {
                            "check_user_access": true
                        }
                    },
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "description": "Enable multi-tenancy (data isolation per tenant).",
                            "default": false,
                            "type": "boolean"
                        },
                        "session_key": {
                            "description": "The session key holding the selected tenant id.",
                            "default": "_tenant_id",
                            "type": "string"
                        },
                        "route_param": {
                            "description": "The route parameter holding the tenant id (route resolver).",
                            "default": "tenant",
                            "type": "string"
                        },
                        "validate_user_access": {
                            "description": "Deny entering a tenant the authenticated user is not a member of.",
                            "default": true,
                            "type": "boolean"
                        },
                        "models": {
                            "default": {
                                "tenant": "SolidWorx\\Platform\\PlatformBundle\\Entity\\Tenant",
                                "user_tenant": "SolidWorx\\Platform\\PlatformBundle\\Entity\\UserTenant"
                            },
                            "type": "object",
                            "properties": {
                                "tenant": {
                                    "description": "The Tenant entity class. Must implement SolidWorx\\Platform\\PlatformBundle\\Model\\TenantInterface",
                                    "default": "SolidWorx\\Platform\\PlatformBundle\\Entity\\Tenant",
                                    "type": "string"
                                },
                                "user_tenant": {
                                    "description": "The UserTenant (membership) entity class. Must implement SolidWorx\\Platform\\PlatformBundle\\Model\\UserTenantInterface",
                                    "default": "SolidWorx\\Platform\\PlatformBundle\\Entity\\UserTenant",
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        },
                        "resolvers": {
                            "default": {
                                "domain": true,
                                "session": true,
                                "route": false
                            },
                            "type": "object",
                            "properties": {
                                "domain": {
                                    "description": "Resolve the tenant from a custom request host.",
                                    "default": true,
                                    "type": "boolean"
                                },
                                "session": {
                                    "description": "Resolve the tenant from the session.",
                                    "default": true,
                                    "type": "boolean"
                                },
                                "route": {
                                    "description": "Resolve the tenant from a route parameter.",
                                    "default": false,
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": false
                        },
                        "write_guard": {
                            "default": {
                                "check_user_access": true
                            },
                            "type": "object",
                            "properties": {
                                "check_user_access": {
                                    "description": "Also verify the current user is a member of the tenant on write.",
                                    "default": true,
                                    "type": "boolean"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "saas": {
            "description": "SaaS / subscription configuration",
            "type": "object",
            "properties": {
                "doctrine": {
                    "type": "object",
                    "properties": {
                        "subscriptions": {
                            "type": "object",
                            "properties": {
                                "entity": {
                                    "description": "The class name of the subscription entity. Must implement SolidWorx\\Platform\\PlatformBundle\\Feature\\SubscribableInterface",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "entity"
                            ],
                            "additionalProperties": false
                        },
                        "trial": {
                            "default": {
                                "user_entity": null
                            },
                            "type": "object",
                            "properties": {
                                "user_entity": {
                                    "description": "The class name of the user entity for trial tracking. Must implement SolidWorx\\Platform\\SaasBundle\\Trial\\TrialUserInterface",
                                    "default": null,
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        },
                        "db_schema": {
                            "default": {
                                "table_names": {
                                    "plan": "saas_plan",
                                    "subscription": "saas_subscription",
                                    "subscription_log": "saas_subscription_log",
                                    "plan_feature": "saas_plan_feature",
                                    "trial": "saas_trial"
                                }
                            },
                            "type": "object",
                            "properties": {
                                "table_names": {
                                    "default": {
                                        "plan": "saas_plan",
                                        "subscription": "saas_subscription",
                                        "subscription_log": "saas_subscription_log",
                                        "plan_feature": "saas_plan_feature",
                                        "trial": "saas_trial"
                                    },
                                    "type": "object",
                                    "properties": {
                                        "plan": {
                                            "description": "The table name for the Plan entity",
                                            "default": "saas_plan",
                                            "type": "string"
                                        },
                                        "subscription": {
                                            "description": "The table name for the Subscription entity",
                                            "default": "saas_subscription",
                                            "type": "string"
                                        },
                                        "subscription_log": {
                                            "description": "The table name for the Subscription logs entity",
                                            "default": "saas_subscription_log",
                                            "type": "string"
                                        },
                                        "plan_feature": {
                                            "description": "The table name for the Plan Feature entity",
                                            "default": "saas_plan_feature",
                                            "type": "string"
                                        },
                                        "trial": {
                                            "description": "The table name for the Trial entity",
                                            "default": "saas_trial",
                                            "type": "string"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "required": [
                        "subscriptions"
                    ],
                    "additionalProperties": false
                },
                "payment": {
                    "type": "object",
                    "properties": {
                        "return_route": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "return_route"
                    ],
                    "additionalProperties": false
                },
                "integration": {
                    "default": {
                        "lemon_squeezy": {
                            "enabled": false,
                            "api_key": "%env(LEMON_SQUEEZY_API_KEY)%",
                            "webhook_secret": "%env(LEMON_SQUEEZY_WEBHOOK_SECRET)%",
                            "store_id": "%env(LEMON_SQUEEZY_STORE_ID)%"
                        }
                    },
                    "type": "object",
                    "properties": {
                        "lemon_squeezy": {
                            "default": {
                                "enabled": false,
                                "api_key": "%env(LEMON_SQUEEZY_API_KEY)%",
                                "webhook_secret": "%env(LEMON_SQUEEZY_WEBHOOK_SECRET)%",
                                "store_id": "%env(LEMON_SQUEEZY_STORE_ID)%"
                            },
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "default": false,
                                    "type": "boolean"
                                },
                                "api_key": {
                                    "default": "%env(LEMON_SQUEEZY_API_KEY)%",
                                    "type": "string"
                                },
                                "webhook_secret": {
                                    "default": "%env(LEMON_SQUEEZY_WEBHOOK_SECRET)%",
                                    "type": "string"
                                },
                                "store_id": {
                                    "default": "%env(LEMON_SQUEEZY_STORE_ID)%",
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                "features": {
                    "description": "Define available plan features and their defaults",
                    "default": [],
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "description": "The data type of the feature value",
                                "type": "string",
                                "enum": [
                                    "boolean",
                                    "integer",
                                    "string",
                                    "array"
                                ]
                            },
                            "default": {
                                "description": "The default value for this feature"
                            },
                            "description": {
                                "description": "A human-readable description of this feature",
                                "default": "",
                                "type": "string"
                            }
                        },
                        "required": [
                            "type",
                            "default"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": [
                "doctrine",
                "payment"
            ],
            "additionalProperties": false
        },
        "ui": {
            "description": "UI / presentation configuration",
            "default": {
                "icon_pack": "tabler",
                "templates": {
                    "base": "@Ui/Layout/base.html.twig",
                    "login": "@Ui/Security/login.html.twig",
                    "layouts": {
                        "app": "@Ui/Layout/app.html.twig",
                        "condensed": "@Ui/Layout/condensed.html.twig",
                        "clean": "@Ui/Layout/clean.html.twig"
                    }
                },
                "layout": {
                    "theme": null,
                    "fluid": false,
                    "boxed": false,
                    "navbar": true,
                    "navbar_theme": null,
                    "navbar_sticky": false,
                    "navbar_overlap": false,
                    "navbar_expand": "md",
                    "sidebar": true,
                    "sidebar_theme": "dark",
                    "sidebar_position": "start",
                    "sidebar_transparent": false,
                    "sidebar_expand": "lg",
                    "page_header": true,
                    "footer": true
                }
            },
            "type": "object",
            "properties": {
                "icon_pack": {
                    "description": "The icon pack to use",
                    "default": "tabler",
                    "type": "string"
                },
                "templates": {
                    "default": {
                        "base": "@Ui/Layout/base.html.twig",
                        "login": "@Ui/Security/login.html.twig",
                        "layouts": {
                            "app": "@Ui/Layout/app.html.twig",
                            "condensed": "@Ui/Layout/condensed.html.twig",
                            "clean": "@Ui/Layout/clean.html.twig"
                        }
                    },
                    "type": "object",
                    "properties": {
                        "base": {
                            "description": "The base template",
                            "default": "@Ui/Layout/base.html.twig",
                            "type": "string"
                        },
                        "login": {
                            "description": "The standard login template",
                            "default": "@Ui/Security/login.html.twig",
                            "type": "string"
                        },
                        "layouts": {
                            "description": "The layouts pages extend, available in Twig as ui_layout_<name>",
                            "default": {
                                "app": "@Ui/Layout/app.html.twig",
                                "condensed": "@Ui/Layout/condensed.html.twig",
                                "clean": "@Ui/Layout/clean.html.twig"
                            },
                            "type": "object",
                            "properties": {
                                "app": {
                                    "description": "Sidebar + top navbar, for the signed-in application",
                                    "default": "@Ui/Layout/app.html.twig",
                                    "type": "string"
                                },
                                "condensed": {
                                    "description": "Top navbar only, without a sidebar",
                                    "default": "@Ui/Layout/condensed.html.twig",
                                    "type": "string"
                                },
                                "clean": {
                                    "description": "No navigation at all, for login / 2FA / error pages",
                                    "default": "@Ui/Layout/clean.html.twig",
                                    "type": "string"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                "layout": {
                    "description": "Application-wide layout defaults; templates override them with {% set layout = {...} %}",
                    "default": {
                        "theme": null,
                        "fluid": false,
                        "boxed": false,
                        "navbar": true,
                        "navbar_theme": null,
                        "navbar_sticky": false,
                        "navbar_overlap": false,
                        "navbar_expand": "md",
                        "sidebar": true,
                        "sidebar_theme": "dark",
                        "sidebar_position": "start",
                        "sidebar_transparent": false,
                        "sidebar_expand": "lg",
                        "page_header": true,
                        "footer": true
                    },
                    "type": "object",
                    "properties": {
                        "theme": {
                            "description": "Forces the colour scheme instead of following the user preference",
                            "default": null,
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                null,
                                "light",
                                "dark"
                            ]
                        },
                        "fluid": {
                            "description": "Use the full width of the viewport",
                            "default": false,
                            "type": "boolean"
                        },
                        "boxed": {
                            "description": "Constrain the page to a boxed width",
                            "default": false,
                            "type": "boolean"
                        },
                        "navbar": {
                            "description": "Render the top navigation bar",
                            "default": true,
                            "type": "boolean"
                        },
                        "navbar_theme": {
                            "description": "Colour scheme of the top navigation bar",
                            "default": null,
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                null,
                                "light",
                                "dark"
                            ]
                        },
                        "navbar_sticky": {
                            "description": "Keep the top navigation bar visible while scrolling",
                            "default": false,
                            "type": "boolean"
                        },
                        "navbar_overlap": {
                            "description": "Let the page body overlap the top navigation bar",
                            "default": false,
                            "type": "boolean"
                        },
                        "navbar_expand": {
                            "description": "Breakpoint at which the top navigation bar expands",
                            "default": "md",
                            "type": "string",
                            "enum": [
                                "sm",
                                "md",
                                "lg",
                                "xl"
                            ]
                        },
                        "sidebar": {
                            "description": "Render the sidebar",
                            "default": true,
                            "type": "boolean"
                        },
                        "sidebar_theme": {
                            "description": "Colour scheme of the sidebar",
                            "default": "dark",
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                null,
                                "light",
                                "dark"
                            ]
                        },
                        "sidebar_position": {
                            "description": "Side the sidebar sits on",
                            "default": "start",
                            "type": "string",
                            "enum": [
                                "start",
                                "end"
                            ]
                        },
                        "sidebar_transparent": {
                            "description": "Remove the sidebar background",
                            "default": false,
                            "type": "boolean"
                        },
                        "sidebar_expand": {
                            "description": "Breakpoint at which the sidebar expands",
                            "default": "lg",
                            "type": "string",
                            "enum": [
                                "sm",
                                "md",
                                "lg",
                                "xl"
                            ]
                        },
                        "page_header": {
                            "description": "Render the page header",
                            "default": true,
                            "type": "boolean"
                        },
                        "footer": {
                            "description": "Render the page footer",
                            "default": true,
                            "type": "boolean"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": true
}